{
  "extends": "../app/tsconfig.base.json",
  "include": ["src/**/*", "../app/src/renderer/types.d.ts"],
  "exclude": ["relay"],
  "compilerOptions": {
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true
  }
}
